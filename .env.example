# Copie para .env e preencha com valores reais.
# Nunca commit o arquivo .env.
DATABASE_URL=
JWT_SECRET_KEY=
# Access token em segundos (ex.: 900 = 15 minutos)
JWT_EXPIRES_IN=900
# Refresh token em segundos (ex.: 604800 = 7 dias)
JWT_REFRESH_EXPIRES_IN=604800
EXPRESS_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development
